---
import Section from "../components/section.astro";
import SectionTitle from "../components/section-title.astro";
import BlogEntry from "../components/blog-entry.astro";
import { getCollection } from "astro:content";
---

<Section>
  <header class="flex justify-between items-center">
    <SectionTitle title="Blog / Insights" />
    <a
      href="/blog"
      class="text-sm text-primary font-family-sans uppercase font-normal tracking-wide hover:underline transition-colors duration-200 cursor-pointer"
      >View all</a
    >
  </header>
  <div class="mt-6">
    {
      (await getCollection("blog", ({ data }) => !data.draft))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .slice(0, 4)
        .map((entry) => (
          <BlogEntry
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            readTime={entry.data.readTime}
            url={`/blog/${entry.id.replace(/\.mdx?$/, "")}`}
          />
        ))
    }
  </div>
</Section>
