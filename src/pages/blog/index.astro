---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/section.astro";
import SectionTitle from "../../components/section-title.astro";
import BlogEntry from "../../components/blog-entry.astro";
import { getCollection } from "astro:content";
import { fade } from "astro:transitions";
---

<Layout
  title="Blog / Insights — Pablo Oyarce"
  description="Reflexiones sobre arquitectura, frontend y desarrollo de producto."
  breadcrumb={[{ label: "Blog", href: undefined }]}
>
  <main
    class="flex flex-col gap-16 container mx-auto max-w-3xl"
    transition:animate={fade({ duration: "0.25s" })}
  >
    <Section>
      <SectionTitle title="Blog / Insights" />
      <div class="mt-6">
        {(await getCollection("blog", ({ data }) => !data.draft))
          .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
          .map((entry) => (
            <BlogEntry
              title={entry.data.title}
              description={entry.data.description}
              category={entry.data.category}
              readTime={entry.data.readTime}
              url={`/blog/${entry.id.replace(/\.mdx?$/, "")}`}
            />
          ))}
      </div>
    </Section>
  </main>
</Layout>
