---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/section.astro";
import SectionTitle from "../../components/section-title.astro";
import ProjectCard from "../../components/project-card.astro";
import { getCollection } from "astro:content";
import { fade } from "astro:transitions";
---

<Layout
  title="Projects — Pablo Oyarce"
  description="Proyectos de producto: agentic workflows, RAG, e-commerce y más."
  breadcrumb={[{ label: "Projects", href: undefined }]}
>
  <main
    class="flex flex-col gap-16 container mx-auto max-w-3xl"
    transition:animate={fade({ duration: "0.25s" })}
  >
    <Section>
      <SectionTitle title="Projects" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
        {
          (await getCollection("projects"))
            .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
            .map((project) => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                url={
                  project.data.url ??
                  `/projects/${project.id.replace(/\.mdx?$/, "")}`
                }
                image={project.data.image}
                alt={project.data.title}
                internal={!project.data.url}
              />
            ))
        }
      </div>
    </Section>
  </main>
</Layout>
