---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/geist";
import "@fontsource/cal-sans";
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import Breadcrumb from "../components/breadcrumb.astro";
import { Minimap } from "../components/minimap";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumb?: BreadcrumbItem[];
}

const { title, description, breadcrumb } = Astro.props;

const metaDescription =
  description ??
  "Pablo Oyarce Ramirez — Product Engineer (TypeScript/Python). Agentic workflows, RAG, and SaaS product engineering. Santiago, Chile. Open to opportunities.";
const siteUrl = (Astro.site?.toString() ?? "https://unstopabloo.dev").replace(
  /\/$/,
  "",
);
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

const ogImage = new URL("/og.png", siteUrl).toString();
const ogImageAlt =
  "Pablo Oyarce Ramirez — Product Engineer focused on AI-first solutions, agentic workflows, and RAG.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#pablo`,
      name: "Pablo Oyarce Ramirez",
      jobTitle: "Product Engineer",
      description: metaDescription,
      url: siteUrl,
      image: ogImage,
      imageAlt: ogImageAlt,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Santiago",
        addressCountry: "CL",
      },
      knowsLanguage: ["es-CL", "en"],
      sameAs: [
        "https://www.linkedin.com/in/pablo-oyarce-ramirez/",
        "https://github.com/Unstopabloo",
      ],
      knowsAbout: [
        "Agentic workflows",
        "RAG architectures",
        "Applied Generative AI",
        "TypeScript",
        "Python",
        "SaaS product engineering",
        "Multi-tenant systems",
        "WebSockets",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      name: "Pablo Oyarce — Product Engineer",
      url: siteUrl,
      description: metaDescription,
      author: { "@id": `${siteUrl}/#pablo` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: metaDescription,
      isPartOf: { "@id": `${siteUrl}/#website` },
      about: { "@id": `${siteUrl}/#pablo` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImage,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={metaDescription} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Pablo Oyarce Ramirez" />
    <meta name="theme-color" content="#0a0a0a" id="theme-color-meta" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pablo Oyarce — Product Developer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="animate" />
    <title>{title}</title>

    <!-- Schema.org JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = stored || (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        const meta = document.getElementById("theme-color-meta");
        if (meta)
          meta.setAttribute(
            "content",
            theme === "dark" ? "#0a0a0a" : "#fafafa",
          );
      })();
    </script>
  </head>
  <body
    class="relative min-h-[96dvh] px-4 sm:px-6 py-14 md:px-20 md:py-20 m-1 md:m-4 rounded-2xl border border-border bg-background font-(--font-family-sans) text-sm"
  >
    {
      breadcrumb && breadcrumb.length > 0 && (
        <div class="container mx-auto max-w-3xl">
          <Breadcrumb items={breadcrumb} />
        </div>
      )
    }
    <slot />
    <Minimap client:load />
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const html = document.documentElement;
        const next =
          html.getAttribute("data-theme") === "light" ? "dark" : "light";
        html.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        const meta = document.getElementById("theme-color-meta");
        if (meta)
          meta.setAttribute("content", next === "dark" ? "#0a0a0a" : "#fafafa");
      });
    </script>
  </body>
</html>
