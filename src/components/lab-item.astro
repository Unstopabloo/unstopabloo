---
interface Props {
  title: string;
  tags: string[];
  url?: string;
}

const { title, tags } = Astro.props;
---

<article
  class="group scroll-reveal rounded-xl border border-border bg-card-background p-5 flex flex-col justify-between cursor-pointer transition-colors duration-200 hover:border-primary/20"
>
  <h3
    class="text-md font-family-display text-soft-white group-hover:text-primary/90 transition-colors duration-200 mb-4 min-h-8"
  >
    {title}
  </h3>
  <div class="flex flex-wrap gap-1.5">
    {
      tags.map((tag) => (
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-family-sans text-softer-white/70 border border-border/40 group-hover:text-primary/60 group-hover:border-primary/20 transition-colors duration-200">
          {tag}
        </span>
      ))
    }
  </div>
</article>
