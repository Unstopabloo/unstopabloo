---
interface Props {
  title: string;
  description: string;
  url: string;
  image?: string;
  alt?: string;
  internal?: boolean;
}

const {
  title,
  description,
  url,
  image,
  alt = title,
  internal = false,
} = Astro.props;
---

<a
  href={url}
  target={internal ? undefined : "_blank"}
  rel={internal ? undefined : "noopener noreferrer"}
  class="group block scroll-reveal rounded-xl border border-border/50 bg-card-base p-1 min-h-80 cursor-pointer transition-colors duration-200 hover:border-primary/20"
>
  <div
    class="flex flex-col rounded-xl bg-card-background border border-border h-full overflow-hidden relative"
  >
    <div class="p-4 flex-1 flex flex-col">
      <h2
        class="text-lg font-family-display mb-2 md:mb-3 text-soft-white group-hover:text-primary/90 transition-colors duration-200"
      >
        {title}
      </h2>
      <p
        class="text-sm text-softer-white font-family-sans leading-relaxed text-pretty font-light mb-4 flex-1"
      >
        {description}
      </p>
    </div>

    <div class="absolute -bottom-1 -right-4">
      {
        image && (
          <div class="card-image-wrapper">
            <img
              src={image}
              alt={`${alt} preview`}
              width={400}
              height={160}
              loading="lazy"
              decoding="async"
              class="card-image"
            />
          </div>
        )
      }
    </div>
  </div>
</a>

<style>
  .card-image-wrapper {
    position: relative;
    height: 10rem;
    overflow: visible;
    flex-shrink: 0;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.3);
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.35))
      drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    transition:
      transform 400ms cubic-bezier(0.32, 0.72, 0, 1),
      filter 350ms cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
    overflow: visible;
  }

  .group:hover .card-image {
    transform: scale(1.4);
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.45))
      drop-shadow(0 0 24px hsl(171 77% 64% / 0.18)) brightness(1.07);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-image {
      transition: filter 200ms ease-out;
    }

    .group:hover .card-image {
      transform: none;
    }
  }
</style>
