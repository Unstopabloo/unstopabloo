---
interface Props {
  company: string;
  role: string;
  description: string;
  period: string;
}

const { company, role, description, period } = Astro.props;
---

<article class="scroll-reveal py-6 last:border-b-0">
  <div class="flex flex-col gap-2">
    <header
      class="flex flex-col md:flex-row md:items-baseline md:flex-1 md:justify-between"
    >
      <h3 class="font-family-sans font-medium text-soft-white">
        {company}
      </h3>
      <p
        class="font-family-serif italic text-softer-white text-sm mt-0.5 md:mt-0 md:text-right font-light leading-relaxed"
      >
        {role}
      </p>
    </header>
    <div class="mt-2 md:mt-0 md:max-w-[65%]">
      <p
        class="text-softer-white/95 font-family-sans leading-relaxed text-pretty font-normal"
      >
        {description}
      </p>
      <p
        class="text-sm font-family-serif italic text-softer-white/70 mt-2 font-light"
      >
        {period}
      </p>
    </div>
  </div>
</article>
